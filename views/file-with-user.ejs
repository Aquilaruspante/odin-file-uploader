<%- include('./header.ejs') %>

<a href="/admin/users/<%= file.user.id %>">User: <%= file.user.username %></a>
<div class="file-display">
    <% if (category === 'image') { %>
        <img src="<%= url %>" alt="<%= file.name %>">
    <% } else if (category === 'video') { %>
        <video controls src="<%= url %>" alt="Problems downloading video"></video>
    <% } else if (category === 'document' || category === 'pdf') { %>
        <iframe id="iframe" style="height: 600px; flex-shrink: 0;" src="<%= url %>" frameborder="0"></iframe>
    <% } else { %>
        <p id="preview-not-available">Preview not avalilable</p>
    <% } %>
    <h2 class="file-title"><%= file.name %></h2>
    <p class="file-detail">Size: <%= size %></p>
    <p class="file-detail">Uploaded: 
        <%= new Date(file.createdat).toLocaleString('en-GB', {
            day: '2-digit',
            month: 'short',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            timeZone: 'Europe/London'
        }) %></p>
    <div class="download-and-delete-line">
        <a href="<%= url %>" download="">Download</a>
        <form action="/folders/<%= file.folderId %>/files/<%= file.id %>?_method=DELETE" method="POST" class="file-delete-form">
            <button class="fake-link">Delete</button>
        </form>
    </div>
    
    <a href="/admin/files">Back</a>
</div>

<%- include('./footer.ejs') %>
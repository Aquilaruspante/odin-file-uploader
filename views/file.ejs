<%- include('./header.ejs') %>

<div class="file-display">
    <% if (category === 'image') { %>
        <img src="<%= url %>" alt="<%= file.name %>">
    <% } else if (category === 'video') { %>
        <video controls src="<%= url %>" alt=file-name"></video>
    <% } else if (category === 'document' || category === 'pdf') { %>
        <iframe id="iframe" style="height: 600px; flex-shrink: 0;" src="<%= url %>" frameborder="0"></iframe>
    <% } else { %>
        <p id="preview-not-available">Preview not avalilable</p>
    <% } %>
    <h2 class="file-title"><%= file.name %></h2>
    <p class="file-detail">Size: <%= file.size %></p>
    <p class="file-detail">Uploaded: <%= file.createdat %></p>
    <a href="<%= url %>" download="">Download</a>
</div>

<%- include('./footer.ejs') %>
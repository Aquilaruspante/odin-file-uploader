<%- include('./header.ejs') %>

<div class="folder-header">
    <div class="folder-header-left">
        <p>/</p>
        <h2 class="folder-title silkscreen-regular"><%= folder.name %></h2>
    </div>
    <% if (locals.user) { %>
        <div class="folder-header-right">
            <a class="share-folder-link silkscreen-regular" href="/folders/<%= folder.id %>/share">Share folder</a>
            <form action="/folders/<%= folder.id %>?_method=DELETE" method="POST" id="folder-title-container">
                <button id="delete-folder-button" class="silkscreen-regular">Delete folder</button>
            </form>
        </div>
    <% } %>
    
</div>

<% if (!folder.files.length) { %>
    <div id="no-files-message-container">
        <p id="no-files-message" class="silkscreen-regular">No files in this folder yet...</p>
        <a href="/folders/<%= folder.id %>/files/new" class="new-folder folder-component">
            <div class="folder-component new-folder">+</div>
        </a>
    </div>
<% } else { %>
    <div class="folder-container">
        <% for (let file of folder.files) { %>
            <a href="/folders/<%= folder.id %>/files/<%= file.id %>">
                <div class="folder-component new-folder">
                    <% if (file.mimetype.split('/')[0] === 'video') { %>
                        <img src="<%= file.url.split('upload')[0] + 'upload' + '/c_scale,h_80' + file.url.split('upload')[1].split('.')[0] + '.jpg' %>" alt="Preview not available">
                    <% } else { %>
                        <img src="<%= file.url.split('upload')[0] + 'upload' + '/c_scale,h_80/q_auto/f_auto' + file.url.split('upload')[1] %>" alt="Preview not available">
                    <% } %>
                </div>
                <p class="file-name"><%= file.name.length > 15 ? `${file.name.slice(0, 14)}(...).${file.name.split('.').findLast(e => (e)) }` : file.name %></p>
            </a>
        <% } %>
        <a href="/folders/<%= folder.id %>/files/new" class="new-folder folder-component">
            <div class="folder-component new-folder">+</div>
        </a>
    </div>
<% } %>
<div class="link-container">
    <a class="back-button" href="/">Back</a>
</div>

<%- include('./footer.ejs') %>
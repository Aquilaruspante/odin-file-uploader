<%- include('./header.ejs') %>

<div id="folder-container">
    <% for (let folder of locals.user.folders) { %>
        <a href="/<%= locals.user.username %>/<%= folder.name %>">
            <div class="folder-component">
                <svg xmlns="http://www.w3.org/2000/svg" 
                    width="80" 
                    height="80" 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    stroke-width="2" 
                    stroke-linecap="round" 
                    stroke-linejoin="round" 
                    class="lucide lucide-folder-closed preview-icon">
                    <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/><path d="M2 10h20"/>
                </svg>
                <h3 class="folder-name"><%= folder.name %></h3>
            </div>
        </a>
         
    <% } %>
</div>

<%- include('./footer.ejs') %>
<%- include('./header.ejs') %>

<form action="/folders/<%= folder.id %>/share" method="POST" class="folder-share-form">
    <h2 class="folder-share-title">Folder name: <%= folder.name %></h2>
    
    <div class="input-and-button-combo">
        <label for="duration">How many days do you wanna share it for?</label>
        <input type="number" id="duration" name="duration" class="folder-duration" min="0" max="7">
    </div>
    <button>Share</button>
</form>

<div class="link-container">
    <a class="back-button" href="/">Back</a>
</div>


<%- include('./footer.ejs') %>